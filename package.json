{
  "name": "sima",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "pnpm --filter @sima/extension dev",
    "build": "pnpm --filter @sima/extension build",
    "build:e2e": "SIMA_PLAYGROUND=1 pnpm --filter @sima/extension build:e2e",
    "zip": "pnpm --filter @sima/extension zip",
    "playground": "node playground/server.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --filter @sima/extension typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "pnpm build:e2e && playwright test",
    "eval": "vitest run --config vitest.eval.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sima/action-planner": "workspace:*",
    "@sima/adapter-core": "workspace:*",
    "@sima/adapter-gradescope": "workspace:*",
    "@sima/adapter-vhl": "workspace:*",
    "@sima/adapter-webassign": "workspace:*",
    "@sima/browser-executor": "workspace:*",
    "@sima/model-providers": "workspace:*",
    "@sima/page-analyzer": "workspace:*",
    "@sima/reasoning-engine": "workspace:*",
    "@sima/shared-types": "workspace:*",
    "@sima/storage": "workspace:*",
    "@sima/task-orchestrator": "workspace:*",
    "@types/chrome": "^0.3.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
